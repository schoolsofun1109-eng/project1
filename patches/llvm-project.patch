+void TestTileOperationGraph::finishMatmulComputeBlock() {
+  matmulFsm = MatmulFsm::Idle;
+  currentMatmulComputeNode = nullptr;
+  mmIvOp0Count = 0;
+  mmExpectedVpop = 0;
+  mmVpopSeen = 0;
